### Caddyfile for the white-label instance at 171.dripdripdrop.ai
#
# This is a SEPARATE file from deploy/Caddyfile (Arena's) on purpose. The two
# hosts cannot share one file: Caddy tries to obtain a certificate for every
# site block it loads, so dropping a 171 block into Arena's Caddyfile would
# make Arena's box repeatedly fail ACME for a hostname whose A record points
# at a different droplet, and vice versa.
#
# Install on the 171 droplet:
#   cp /opt/dripdrop/app/deploy/Caddyfile.171 /etc/caddy/Caddyfile
#   systemctl restart caddy
#
# Cloudflare SSL/TLS must be **Full (strict)**. Flexible sends plain HTTP to a
# Caddy that redirects to HTTPS, producing a redirect loop.

171.dripdripdrop.ai {
    # Blue/green failover — try :8080 (blue) first, fall back to :8081 (green)
    # based on active health checks against /healthz. Works for both
    # directions of the zero-downtime swap in _deploy_zero_downtime.sh:
    # whichever color is healthy takes all traffic within ~3s.
    reverse_proxy localhost:8080 localhost:8081 {
        lb_policy first
        health_uri /healthz
        health_interval 3s
        health_timeout 2s
    }
}

# No mcp.* block and no internal :8082 block here: the MCP connector is
# deliberately out of scope for this instance (separate service, own subdomain
# and OAuth registration). If it is ever added, copy both blocks from
# deploy/Caddyfile — the :8082 loopback endpoint is what keeps the connector
# working across blue/green swaps, and it must not be dropped.
