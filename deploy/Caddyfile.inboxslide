### Caddyfile for the inboxslide.ai instance
#
# This is a SEPARATE file from deploy/Caddyfile (Arena's) on purpose. The two
# hosts cannot share one file: Caddy tries to obtain a certificate for every
# site block it loads, so dropping an inboxslide block into Arena's Caddyfile
# would make Arena's box repeatedly fail ACME for a hostname whose A record points
# at a different droplet, and vice versa.
#
# Install on the inboxslide droplet:
#   cp /opt/dripdrop/app/deploy/Caddyfile.inboxslide /etc/caddy/Caddyfile
#   systemctl restart caddy
#
# Cloudflare SSL/TLS must be **Full (strict)**. Flexible sends plain HTTP to a
# Caddy that redirects to HTTPS, producing a redirect loop.

# NOTE: bootstrap-instance.sh substitutes the hostname on the line below by
# matching it literally. If you edit it here, edit the sed in that script too.
app.inboxslide.ai {
    # Blue/green failover — try :8080 (blue) first, fall back to :8081 (green)
    # based on active health checks against /healthz. Works for both
    # directions of the zero-downtime swap in _deploy_zero_downtime.sh:
    # whichever color is healthy takes all traffic within ~3s.
    reverse_proxy localhost:8080 localhost:8081 {
        lb_policy first
        health_uri /healthz
        health_interval 3s
        health_timeout 2s
    }
}

mcp.inboxslide.ai {
    # Claude connector (dripdrop-mcp.service). Independent process from the
    # blue/green app, single local port, no failover needed. Its env lives in
    # /opt/dripdrop/.env (DRIPDROP_MCP_PUBLIC_URL, bridge secret).
    reverse_proxy localhost:8090
}

:8082 {
    # Internal-only blue/green failover endpoint for the connector's
    # DRIPDROP_API_BASE_URL, so it keeps working across blue/green swaps.
    # Loopback only, never exposed externally. Do not drop it.
    bind 127.0.0.1
    reverse_proxy localhost:8080 localhost:8081 {
        lb_policy first
        health_uri /healthz
        health_interval 3s
        health_timeout 2s
    }
}
